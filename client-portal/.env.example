# Dedicated PostgreSQL. Never commit actual credentials.
DATABASE_URL=postgresql://krm:YOUR_PASSWORD@localhost:5432/krm_portal
APP_ORIGIN=https://your-private-portal.example
NODE_ENV=production
# Production refuses traffic until explicitly enabled after security checks.
LAUNCH_ENABLED=false
PORT=3000

# One-time admin bootstrap CLI only; delete values afterwards:
# SETUP_ADMIN_EMAIL=
# SETUP_ADMIN_NAME=
# SETUP_ADMIN_PASSWORD=
